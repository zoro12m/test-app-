{
  "name": "shopfinance-firestore-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Firestore security rules tests, run against the local Firestore emulator.",
  "type": "module",
  "scripts": {
    "test": "mocha",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-shopfinance --config ../firebase.json \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1",
    "mocha": "12.0.3"
  }
}
