rules_version = '2';

// Shop Finance security rules: shops, the cash ledger (USD only) and debts (USD or LBP).
//
// Anything not matched below is denied. Tests: firestore-tests/ (run against the
// Firestore emulator; see .github/workflows/firestore-rules.yml).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Every field a shop document has, no more and no less.
    function shopKeys() {
      return ['name', 'ownerUid', 'memberUids', 'currency', 'createdAt', 'updatedAt', 'schemaVersion'];
    }

    // Must agree with ShopNameRules in the app: trimmed, 1..60 characters. size() counts
    // UTF-16 code units, like Kotlin String.length; trim() strips characters <= U+0020.
    function isValidShopName(name) {
      return name is string
        && name == name.trim()
        && name.size() >= 1
        && name.size() <= 60;
    }

    // True when the caller is listed in the shop's memberUids. Used by the shop's
    // subcollections; get() reads the shop document once per request.
    function isMember(shopId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/shops/$(shopId)).data.memberUids;
    }

    // Ledger entry types Stage 3 records: cash only, no customer or supplier. The
    // credit types (debt_given, liability_in, ...) come with parties in a later stage.
    function entryTypes() {
      return ['sale', 'expense', 'capital_in', 'capital_out'];
    }

    // Expense categories, the same list as ExpenseCategory in the app.
    function expenseCategories() {
      return ['goods', 'rent', 'electricity', 'salaries', 'transport', 'maintenance', 'other'];
    }

    // A new entry exactly as the app writes it. Amounts are whole cents, positive, at
    // most 100,000,000.00 USD; the entry type decides which way the money moves.
    function isValidNewEntry(data) {
      return data.keys().hasAll(['type', 'amountMinor', 'currency', 'occurredAt', 'note',
                                 'createdBy', 'createdAt', 'schemaVersion'])
        && data.keys().hasOnly(['type', 'amountMinor', 'currency', 'occurredAt', 'note',
                                'createdBy', 'createdAt', 'schemaVersion', 'categoryId'])
        && data.type in entryTypes()
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= 10000000000
        && data.currency == 'USD'
        && data.occurredAt is timestamp
        && data.occurredAt >= timestamp.date(2000, 1, 1)
        // A day of slack for clocks and time zones; nothing further in the future.
        && data.occurredAt <= request.time + duration.value(1, 'd')
        && data.note is string
        && data.note.size() <= 200
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && (data.type == 'expense'
              ? data.get('categoryId', null) in expenseCategories()
              : !data.keys().hasAny(['categoryId']));
    }

    // Why an entry was voided: trimmed, 1..200 characters, like LedgerInputRules in the app.
    function isValidVoidReason(reason) {
      return reason is string
        && reason == reason.trim()
        && reason.size() >= 1
        && reason.size() <= 200;
    }

    // Must agree with DebtInputRules in the app. A debtor's name: trimmed, 1..60 characters.
    function isValidDebtorName(name) {
      return name is string
        && name == name.trim()
        && name.size() >= 1
        && name.size() <= 60;
    }

    // A phone number as the app stores it: Western digits, spaces, + and -, 1..20 characters,
    // trimmed, with at least one digit.
    function isValidPhone(phone) {
      return phone is string
        && phone == phone.trim()
        && phone.matches('^[0-9 +-]{1,20}$')
        && phone.matches('.*[0-9].*');
    }

    // A document id the app links to (Firestore auto ids are 20 letters and digits).
    function isValidDocId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    // A calendar day as the app writes it, "2026-10-01": from 2000-01-01 to the day after
    // the server's today (slack for time zones).
    function isValidDay(day) {
      return day is string
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && day >= '2000-01-01'
        && dayStart(day) <= request.time + duration.value(1, 'd');
    }

    // Midnight UTC at the start of a calendar day written as "2026-10-01".
    function dayStart(day) {
      let parts = day.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
    }

    // A new debtor exactly as the app writes it; phone is left out when empty.
    function isValidNewDebtor(data) {
      return data.keys().hasAll(['name', 'note', 'createdBy', 'createdAt', 'schemaVersion'])
        && data.keys().hasOnly(['name', 'phone', 'note', 'createdBy', 'createdAt', 'schemaVersion'])
        && isValidDebtorName(data.name)
        && (!('phone' in data) || isValidPhone(data.phone))
        && data.note is string
        && data.note.size() <= 200
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.schemaVersion is int
        && data.schemaVersion == 1;
    }

    // A new debt exactly as the app writes it. Amounts are whole cents (USD) or whole lira
    // (LBP), positive, at most 10,000,000,000 of either. The debtor must be in this shop.
    function isValidNewDebt(shopId, data) {
      return data.keys().hasAll(['debtorId', 'amountMinor', 'currency', 'debtDate', 'note',
                                 'createdBy', 'createdAt', 'schemaVersion'])
        && data.keys().hasOnly(['debtorId', 'amountMinor', 'currency', 'debtDate', 'note',
                                'createdBy', 'createdAt', 'schemaVersion'])
        && isValidDocId(data.debtorId)
        && exists(/databases/$(database)/documents/shops/$(shopId)/debtors/$(data.debtorId))
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= 10000000000
        && data.currency in ['USD', 'LBP']
        && isValidDay(data.debtDate)
        && data.note is string
        && data.note.size() <= 200
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.schemaVersion is int
        && data.schemaVersion == 1;
    }

    // A new payment exactly as the app writes it, against a debt of this shop that is not
    // deleted. It may not exceed the debt's amount or be dated before the debt. Rules cannot
    // add up the earlier payments, so "not more than the remaining" is checked by the app.
    function isValidNewPayment(shopId, data) {
      return data.keys().hasAll(['debtId', 'amountMinor', 'paymentDate', 'note',
                                 'createdBy', 'createdAt', 'schemaVersion'])
        && data.keys().hasOnly(['debtId', 'amountMinor', 'paymentDate', 'note',
                                'createdBy', 'createdAt', 'schemaVersion'])
        && isValidDocId(data.debtId)
        && isPayableDebt(get(/databases/$(database)/documents/shops/$(shopId)/debts/$(data.debtId)), data)
        && data.note is string
        && data.note.size() <= 200
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.schemaVersion is int
        && data.schemaVersion == 1;
    }

    // [debt] is the stored debt a new payment [data] points at, or null when there is none.
    function isPayableDebt(debt, data) {
      return debt != null
        && !('deletedAt' in debt.data)
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= debt.data.amountMinor
        && isValidDay(data.paymentDate)
        && data.paymentDate >= debt.data.debtDate;
    }

    // Marking a debt or payment deleted: once, by a member, and nothing else changes. The
    // document stays, so a mistaken delete can be traced.
    function isSoftDelete() {
      return !('deletedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy'])
        && request.resource.data.deletedAt == request.time
        && request.resource.data.deletedBy == request.auth.uid;
    }

    // Reserved for later stages; the app does not write it yet.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /shops/{shopId} {
      // List queries are allowed only when they filter on
      // memberUids array-contains the caller's uid.
      allow get, list: if isSignedIn()
        && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(shopKeys())
        && request.resource.data.keys().hasOnly(shopKeys())
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.currency == 'USD'
        && isValidShopName(request.resource.data.name)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 1;

      // Only the owner may rename the shop; nothing else may change.
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && isValidShopName(request.resource.data.name)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      // The shop's ledger: one document per cash entry. Entries are append-only: the only
      // change allowed after creation is voiding it once, with a reason. Must agree with
      // LedgerFields and newEntryFields in the app.
      match /entries/{entryId} {
        allow read: if isMember(shopId);

        allow create: if isMember(shopId) && isValidNewEntry(request.resource.data);

        allow update: if isMember(shopId)
          && !('voidedAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['voidedAt', 'voidReason', 'voidedBy'])
          && request.resource.data.voidedAt == request.time
          && request.resource.data.voidedBy == request.auth.uid
          && isValidVoidReason(request.resource.data.voidReason);

        allow delete: if false;
      }

      // Debts: who owes the shop money (debtors), what each person took (debts) and what
      // they paid back (debtPayments). Remaining balances are never stored; the app works
      // them out from the payments. Nothing can be edited after saving, and nothing is ever
      // removed: a debt or payment is only marked deleted. Must agree with DebtFields in the app.
      match /debtors/{debtorId} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId) && isValidNewDebtor(request.resource.data);
        allow update, delete: if false;
      }

      match /debts/{debtId} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId) && isValidNewDebt(shopId, request.resource.data);
        allow update: if isMember(shopId) && isSoftDelete();
        allow delete: if false;
      }

      match /debtPayments/{paymentId} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId) && isValidNewPayment(shopId, request.resource.data);
        allow update: if isMember(shopId) && isSoftDelete();
        allow delete: if false;
      }

      // Parties, dues and anything else arrive in later stages with their own rules;
      // until then every other subcollection is denied (an allow above still applies,
      // rules only ever add access). The collection segment is spelled out on purpose:
      // a bare {document=**} here would also match the shop document itself.
      match /{subcollection}/{rest=**} {
        allow read, write: if false;
      }
    }
  }
}
